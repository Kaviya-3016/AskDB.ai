# ===============================================
# QueryCraft AI - Enterprise Configuration
# ===============================================

# App & Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Enterprise NLP-to-SQL Generator"

# Security & JWT
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 (Open Source / Enterprise)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:5173, http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Primary Application & Demo Databases
# Local SQLite defaults:
DATABASE_URL=sqlite+aiosqlite:///./nlp_sql.db
DEMO_DATABASE_URL=sqlite+aiosqlite:///./demo_ecommerce.db

# PostgreSQL Production Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nlp_sql_db
# DEMO_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nlp_sql_db

# Redis Caching (optional for local, defaults to in-memory fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Rate Limiting
RATE_LIMIT_PER_HOUR=100

# ML Model Settings
ML_MODEL_NAME=t5-base-text2sql
USE_MOCK_FALLBACK=true
